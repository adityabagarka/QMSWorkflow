# --- Supabase (staging: ap-south-1 / Mumbai) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never exposed to the browser, never committed.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by migrations/tests/import only (not by the app).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# --- Access control (ARCHITECTURE.md §15) ---
# Comma-separated Google Workspace domains permitted to raise an access request.
# Any successful Google sign-in from outside this list is rejected outright.
# NOTE: bagarka.in is present only so the bootstrap Super Admin below can sign in.
# Remove it once that account is migrated to a plumhq.com identity.
ALLOWED_EMAIL_DOMAINS=plumhq.com,bagarka.in
# Seeded at migration time as the initial Super Admin (bootstrap; see docs/decisions/0002).
BOOTSTRAP_SUPER_ADMIN_EMAIL=aditya@bagarka.in
