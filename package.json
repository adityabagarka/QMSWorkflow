{
  "name": "qms-workflow",
  "version": "0.0.0",
  "private": true,
  "description": "Rollover Quote Management System \u2014 M0 foundation",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/migrate.ts --reset",
    "db:smoke": "tsx scripts/smoke-staging.ts",
    "db:test": "tsx scripts/run-pgtap.ts",
    "db:import-guardrails": "tsx scripts/import-guardrails/index.ts",
    "db:seed:synthetic": "tsx scripts/seed-synthetic.ts",
    "test:parse": "tsx scripts/__tests__/parse-connection-string.ts",
    "db:check": "tsx scripts/check-connection.ts",
    "test:routes": "tsx scripts/__tests__/wizard-routes.ts",
    "verify": "bash scripts/verify.sh",
    "test:migrations": "tsx scripts/__tests__/migrations-against-dirty-data.ts",
    "test:rfq": "tsx scripts/__tests__/rfq-workbook.ts",
    "test:members": "tsx scripts/__tests__/members-and-burn.ts",
    "test:parsing": "tsx scripts/__tests__/parsing.ts",
    "test:cover-start": "tsx scripts/__tests__/cover-start.ts",
    "test:fonts": "cd docs/design-review && node font-roles.mjs",
    "test:time": "TZ=UTC tsx scripts/__tests__/time-zone.ts && TZ=Asia/Kolkata tsx scripts/__tests__/time-zone.ts",
    "test:extraction": "tsx scripts/__tests__/policy-extraction.ts",
    "test:term-writes": "tsx scripts/__tests__/term-writes.ts",
    "test:policy-facts": "tsx scripts/__tests__/policy-facts.ts",
    "test:policy-fill": "tsx scripts/__tests__/policy-fill.ts",
    "test:page-queries": "tsx scripts/__tests__/page-queries.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^14.2.15",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "exceljs": "^4.4.0",
    "pg": "^8.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
